# ── App ──────────────────────────────────────────────
APP_ENV=production
DEBUG=false
SECRET_KEY=generate-a-strong-random-secret-here

# ── JWT ──────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── AI Providers (set at least one) ──────────────────
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=

DEFAULT_PROVIDER=replicate

# ── Database ─────────────────────────────────────────
# SQLite (default, good for single-server):
DATABASE_URL=sqlite+aiosqlite:///./imagegen.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/imagegen

# ── CORS ─────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ── Storage ──────────────────────────────────────────
# Local filesystem (default):
STORAGE_BACKEND=local
STORAGE_PATH=./generated

# Cloudflare R2 (recommended for production):
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=imagegen-images
# R2_PUBLIC_URL=https://your-r2-domain.com

# AWS S3 (alternative):
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=imagegen-images
# S3_PUBLIC_URL=https://your-cloudfront-domain.com

# ── SMTP (Gmail for password reset) ──────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=your@gmail.com
RESET_TOKEN_EXPIRE_MINUTES=15

# ── Rate Limits ───────────────────────────────────────
DAILY_GENERATION_LIMIT=50
MONTHLY_GENERATION_LIMIT=1000
