# ============================================================
# ImageGen MVP — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=development          # development | production
DEBUG=true
SECRET_KEY=change-me-in-production

# ── JWT ──────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080     # 7 days

# ── AI Provider Keys (at least one required) ─────────────────
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Default provider when none is specified
DEFAULT_PROVIDER=replicate   # replicate | openai | gemini

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./imagegen.db

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Storage ──────────────────────────────────────────────────
# Which backend to use: local | r2 | s3
# WARNING: 'local' stores images on the server disk.
#          Images will be LOST on redeploy (Railway, Render, etc).
#          Use 'r2' or 's3' for production.
STORAGE_BACKEND=local

# Local storage path (only used when STORAGE_BACKEND=local)
STORAGE_PATH=./generated

# ── Cloudflare R2 (recommended for production) ───────────────
# 1. Create a Cloudflare account -> R2 -> Create bucket
# 2. Settings -> R2 API Tokens -> Create token (Object Read & Write)
# 3. Enable Public Access on the bucket (or add a custom domain)
#
R2_ACCOUNT_ID=              # Cloudflare account ID (32-char hex)
R2_ACCESS_KEY_ID=           # R2 API token Access Key ID
R2_SECRET_ACCESS_KEY=       # R2 API token Secret Access Key
R2_BUCKET_NAME=imagegen-images
R2_PUBLIC_URL=              # e.g. https://pub-xxx.r2.dev  (no trailing slash)

# ── AWS S3 (alternative to R2) ───────────────────────────────
# Bucket policy required for public read (do NOT use per-object ACLs):
#   {
#     "Version": "2012-10-17",
#     "Statement": [{
#       "Effect": "Allow",
#       "Principal": "*",
#       "Action": "s3:GetObject",
#       "Resource": "arn:aws:s3:::YOUR_BUCKET_NAME/*"
#     }]
#   }
#
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=imagegen-images
S3_PUBLIC_URL=              # e.g. https://imagegen-images.s3.amazonaws.com

# ── SMTP (password reset emails) ─────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=
RESET_TOKEN_EXPIRE_MINUTES=15

# ── Rate Limits ───────────────────────────────────────────────
DAILY_GENERATION_LIMIT=50
MONTHLY_GENERATION_LIMIT=1000
