# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_SECRET

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── AI Providers ──────────────────────────────────────────────────────────────
REPLICATE_API_TOKEN=REPLACE_WITH_REPLICATE_TOKEN
OPENAI_API_KEY=
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY

DEFAULT_PROVIDER=replicate

# ── Database ──────────────────────────────────────────────────────────────────
# Set by docker-compose via DATABASE_URL env override — do not change this line
# when deploying with docker-compose.yml (it overrides to the postgres container).
# For Railway / Render set DATABASE_URL in their dashboard instead.
DATABASE_URL=postgresql+asyncpg://imagegen:REPLACE_WITH_DB_PASSWORD@db:5432/imagegen

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com

# ── Storage ───────────────────────────────────────────────────────────────────
# Option A — Local volume (simplest; images stored in /app/generated mount)
STORAGE_BACKEND=local
STORAGE_PATH=./generated

# Option B — Cloudflare R2 (recommended; survives container restarts)
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=REPLACE
# R2_ACCESS_KEY_ID=REPLACE
# R2_SECRET_ACCESS_KEY=REPLACE
# R2_BUCKET_NAME=imagegen-images
# R2_PUBLIC_URL=https://pub-REPLACE.r2.dev

# Option C — AWS S3
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=REPLACE
# AWS_SECRET_ACCESS_KEY=REPLACE
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=imagegen-images
# S3_PUBLIC_URL=https://REPLACE.cloudfront.net

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SENDER_EMAIL=your@gmail.com
RESET_TOKEN_EXPIRE_MINUTES=15

# ── Rate Limits ───────────────────────────────────────────────────────────────
DAILY_GENERATION_LIMIT=50
MONTHLY_GENERATION_LIMIT=1000
