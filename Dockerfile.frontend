# ── Stage 1: builder ─────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files first for layer caching
COPY package*.json ./

# Install dependencies (clean install from lockfile)
RUN npm ci

# Copy the rest of the source
COPY . .

# Build the Vite app
RUN npm run build


# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM nginx:alpine AS runtime

# Copy built dist from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Write custom nginx config with gzip, security headers, and long AI timeouts
RUN printf '\
# Gzip compression\n\
gzip on;\n\
gzip_vary on;\n\
gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml;\n\
gzip_min_length 1024;\n\
\n\
server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    # Security headers\n\
    add_header X-Frame-Options "SAMEORIGIN" always;\n\
    add_header X-Content-Type-Options "nosniff" always;\n\
    add_header X-XSS-Protection "1; mode=block" always;\n\
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;\n\
\n\
    # Cache static assets aggressively (Vite hashes filenames)\n\
    location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
        try_files $uri =404;\n\
    }\n\
\n\
    # SPA routing — serve index.html for all non-file routes\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
        add_header Cache-Control "no-cache";\n\
    }\n\
\n\
    # Proxy /api to the backend service\n\
    # Long timeouts needed: AI generation can take 60-120 s\n\
    location /api {\n\
        proxy_pass http://backend:8000;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n\
        proxy_set_header X-Forwarded-Proto $scheme;\n\
        proxy_read_timeout 180s;\n\
        proxy_connect_timeout 10s;\n\
        proxy_send_timeout 180s;\n\
        client_max_body_size 20M;\n\
    }\n\
\n\
    # Proxy /images to the backend service\n\
    location /images {\n\
        proxy_pass http://backend:8000;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header X-Real-IP $remote_addr;\n\
        proxy_cache_valid 200 7d;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80 443
